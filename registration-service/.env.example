# Copy this file to .env and fill in real values. .env is gitignored -- never commit it.

# Postgres connection string. docker-compose.yml in this directory spins up a local one
# matching these defaults for development.
DATABASE_URL=postgres://registration:registration@localhost:5433/registration

# Port this service listens on.
PORT=3001

# From your X (Twitter) Developer App -- Settings -> User authentication settings.
# Must be an OAuth 2.0 app with "Confidential client" and PKCE enabled.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Must exactly match one of the app's registered callback URLs (including scheme/port).
# For local dev: http://localhost:3001/auth/x/callback
X_REDIRECT_URI=http://localhost:3001/auth/x/callback

# The private key this service signs attestations with. Its PUBLIC address must match
# Registry.attestor() on-chain -- see ../contracts/deployments/46630.json's "attestor" field
# (currently the deployer's own address, a placeholder). Rotate it to the real address this
# key derives (call Registry.setAttestor(...) as the contract owner) once this service is
# actually running -- never leave it on the deployer placeholder in a real deployment.
ATTESTOR_PRIVATE_KEY=

# Optional overrides if X's OAuth endpoint hostnames differ from this service's defaults --
# see src/xOAuth.js's file header for why these are configurable rather than hardcoded.
# X_AUTH_URL=https://x.com/i/oauth2/authorize
# X_TOKEN_URL=https://api.x.com/2/oauth2/token
# X_USERINFO_URL=https://api.x.com/2/users/me
