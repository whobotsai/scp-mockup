# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Robinhood Chain Testnet (see ../README.md for other networks' values)
RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc

# The deployer wallet's private key. Fund this address from the testnet faucet first:
# https://faucet.testnet.chain.robinhood.com/add-chain
DEPLOYER_PRIVATE_KEY=

# Optional — all default to the deployer's own address if left unset (fine for an initial
# testnet deploy; rotate these to the real addresses before mainnet). See scripts/deploy.js.
OWNER_ADDRESS=
TREASURY_ADDRESS=
KEEPER_ADDRESS=
ATTESTOR_ADDRESS=
