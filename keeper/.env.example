# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Alchemy (or any archive-capable) RPC endpoint for Robinhood Chain Testnet.
RPC_URL=

# Postgres connection string. docker-compose.yml in this directory spins up a local one
# matching these defaults for development.
DATABASE_URL=postgres://keeper:keeper@localhost:5432/keeper

# SHOFactory address from ../contracts/deployments/46630.json.
SHO_FACTORY_ADDRESS=0x257F835b1066c064e9e9896c31556034f8Eee8c9

# Block SHOFactory above was actually deployed at (confirmed via the explorer's "Contract
# Creation" transaction) — the indexer's backfill starts scanning here instead of from block
# 0. Leaving this at 0 is *not* safe even on a young testnet: at a 10-block-per-call rate
# (see GET_LOGS_MAX_BLOCK_RANGE below, a free-tier RPC limit), scanning from genesis takes
# one request per 10 blocks of the chain's entire history — confirmed painfully slow in
# practice. Pointing a factory at a different network needs this looked up again for that
# deployment.
SHO_FACTORY_DEPLOY_BLOCK=113331159

# How often (ms) the indexer polls for new blocks/logs. ethers' JsonRpcProvider polls rather
# than holding a websocket open, so this is a plain interval, not a push subscription.
POLL_INTERVAL_MS=15000

# Max block range per eth_getLogs call. Alchemy's free tier caps this at 10 blocks (an
# "Under the Free tier plan..." error means this is set too high for your plan) — default
# of 9 (a 10-block-wide range, since it's inclusive on both ends) is sized for that. Raise it
# once on a paid plan, to cut down on the number of requests needed to backfill.
GET_LOGS_MAX_BLOCK_RANGE=9

# Only needed to run scripts/post-milestone-root.js (posting a computed snapshot on-chain).
# Its address must match SHOFactory's keeper() (see ../contracts/deployments/46630.json's
# "keeper" field — currently the deployer's own address, a Stage 0 placeholder). Never used
# by the main keeper process (npm start) itself, which only reads chain state and never
# signs a transaction.
KEEPER_PRIVATE_KEY=

# Only needed to run scripts/claim-milestone.js. Private key of the wallet claiming its share
# of a posted milestone reward -- must belong to whichever account actually appears in that
# milestone's leaderboard snapshot (scripts/claim-milestone.js errors clearly if it isn't
# there). In the dev/test flow this session has been running, the wallet that did the real
# test swaps is the deployer's own address, so this can be the same key as
# ../contracts/.env's DEPLOYER_PRIVATE_KEY -- in general it's whoever the eligible wallet is.
CLAIMANT_PRIVATE_KEY=
