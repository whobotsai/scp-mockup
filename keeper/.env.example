# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Alchemy (or any archive-capable) RPC endpoint for Robinhood Chain Testnet.
RPC_URL=

# Postgres connection string. docker-compose.yml in this directory spins up a local one
# matching these defaults for development.
DATABASE_URL=postgres://keeper:keeper@localhost:5432/keeper

# SHOFactory address from ../contracts/deployments/46630.json.
SHO_FACTORY_ADDRESS=0x257F835b1066c064e9e9896c31556034f8Eee8c9

# Block SHOFactory was deployed at — look this up on the explorer
# (https://explorer.testnet.chain.robinhood.com/address/0x257F835b1066c064e9e9896c31556034f8Eee8c9)
# so the indexer's backfill doesn't have to scan from block 0. Safe to leave at 0 on a young
# testnet where that's still fast; required once the chain has real history behind it.
SHO_FACTORY_DEPLOY_BLOCK=0

# How often (ms) the indexer polls for new blocks/logs. ethers' JsonRpcProvider polls rather
# than holding a websocket open, so this is a plain interval, not a push subscription.
POLL_INTERVAL_MS=15000
