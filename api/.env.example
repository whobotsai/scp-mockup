# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Same Postgres instance the keeper writes to -- this API only reads it, never writes.
DATABASE_URL=postgres://keeper:keeper@localhost:5432/keeper

# Port this API listens on.
PORT=3001

# Enables live reads of indexed Solana campaigns (see solanaProvider.js / solanaAbis.js).
# Unset means a Solana campaign row in the DB (from keeper/src/solanaCampaignIndexer.js) just
# fails to load individually rather than blocking the rest of /sho/campaigns or /sso/campaigns.
SOLANA_RPC_URL=

# Optional -- EVM/Robinhood support, deferred to a later phase (see
# docs/SOLANA_MAINNET_LAUNCH_PLAN.md). Same RPC endpoint the keeper would use. Unset means EVM
# campaigns stay off the same way SOLANA_RPC_URL being unset does; tokenRoutes.js/
# walletRoutes.js (EVM-only, no Solana counterpart) aren't mounted at all right now -- see
# server.js's own header.
RPC_URL=

# Optional -- enables a Solana SHO campaign's leaderboard (solanaTraderIndexer.js, Birdeye's
# Token - Top Traders API). Unset means topLeaderboard/.../leaderboard just come back empty
# for a Solana campaign, same "stays off without it" posture as SOLANA_RPC_URL above.
BIRDEYE_API_KEY=
