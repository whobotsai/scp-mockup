# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Same Postgres instance the keeper writes to -- this API only reads it, never writes.
DATABASE_URL=postgres://keeper:keeper@localhost:5432/keeper

# Same RPC endpoint the keeper uses.
RPC_URL=

# Port this API listens on.
PORT=3001

# Optional -- enables live reads of indexed Solana campaigns (see solanaProvider.js /
# solanaAbis.js). Unset means this API stays EVM-only; a Solana campaign row in the DB
# (from keeper/src/solanaCampaignIndexer.js) just fails to load individually rather than
# blocking the rest of /sho/campaigns or /sso/campaigns.
SOLANA_RPC_URL=
